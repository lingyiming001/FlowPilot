# 使用 deploy/scripts/start.sh 自动生成本地开发密钥；生产必须单独配置。
COMPOSE_PROJECT_NAME=flowpilot
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
DB_USERNAME=flowpilot
JWT_SECRET=
ENCRYPTION_KEY=
REDIS_PASSWORD=
DEMO_ENABLED=true
DEMO_PASSWORD=
LLM_MODE=fake
INTEGRATION_MODE=mock
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
GATEWAY_URL=
GATEWAY_TOKEN=
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
WEB_PORT=18080
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_ACCOUNT_ID=
IDENTITY_VERIFIER_URL=
AUTO_ANALYZE_ENABLED=false
BOOTSTRAP_ENABLED=false
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=
BOOTSTRAP_TEAM=team-default
MAIL_HEALTH_ENABLED=false
BACKEND_MEMORY_LIMIT=768m
REDIS_TIMEOUT=10s
REDIS_CONNECT_TIMEOUT=10s

# 本地 HTTP 为 false；生产 HTTPS 设为 true。
AUTH_COOKIE_SECURE=false
